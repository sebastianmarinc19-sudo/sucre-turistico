PORT=4000
DESTINOS_URL=http://localhost:4001
ALOJAMIENTO_URL=http://localhost:4002
GASTRONOMIA_URL=http://localhost:4003
EXPERIENCIAS_URL=http://localhost:4004
EVENTOS_URL=http://localhost:4005
BUSCADOR_URL=http://localhost:4006

# Autenticacion del panel de administracion.
# Este valor es solo para desarrollo local: en produccion (Render) hay que poner
# uno distinto y secreto. Generar uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=desarrollo-local-no-usar-en-produccion

# El gateway consulta la tabla `usuarios` para el login.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=sucre_turistico
DB_SSL=false
